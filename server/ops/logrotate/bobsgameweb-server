# Logrotate example for backend-related logs.
#
# Adjust paths if you write custom app logs in addition to journald.
# If you rely solely on journald, use journalctl vacuum settings separately.

/var/log/nginx/ws.bobsgame.com*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid)
    endscript
}
