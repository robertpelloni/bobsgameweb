# Optional production overrides for the static web build
#
# Recommended once a dedicated websocket/backend host exists:
#   VITE_SERVER_URL=https://ws.bobsgame.com
#
# Optional asset override if large assets move elsewhere:
#   VITE_BIG_DATA_URL=https://bobsgame.s3.amazonaws.com/z/

VITE_SERVER_URL=https://bobsgame.com
VITE_BIG_DATA_URL=https://bobsgame.s3.amazonaws.com/z/
